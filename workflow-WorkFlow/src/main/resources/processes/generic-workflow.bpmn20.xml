<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://smi.tn/workflow"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL
             http://www.omg.org/spec/BPMN/20100524/MODEL/BPMN20.xsd">

    <process id="generic-workflow" name="Generic Workflow Process" isExecutable="true">

        <!-- Start Event -->
        <startEvent id="startEvent" name="Start"/>

        <!-- Sequence: Start -> UserTask -->
        <sequenceFlow id="flow_start_to_task" sourceRef="startEvent" targetRef="userTask"/>

        <!-- User Task (dynamic, uses currentNodeKey variable) -->
        <userTask id="userTask" name="Workflow Task"
                  flowable:candidateGroups="workflow-users">
            <extensionElements>
                <flowable:taskListener event="create"
                    delegateExpression="${onTaskCreateListener}"/>
                <flowable:taskListener event="complete"
                    delegateExpression="${onTaskCompleteListener}"/>
            </extensionElements>
        </userTask>

        <!-- Sequence: UserTask -> RouteDelegate -->
        <sequenceFlow id="flow_task_to_route" sourceRef="userTask" targetRef="routeServiceTask"/>

        <!-- Service Task: Route Delegate -->
        <serviceTask id="routeServiceTask" name="Route Decision"
                     flowable:delegateExpression="${routeDelegate}"/>

        <!-- Sequence: RouteDelegate -> Gateway -->
        <sequenceFlow id="flow_route_to_gateway" sourceRef="routeServiceTask" targetRef="exclusiveGateway"/>

        <!-- Exclusive Gateway: END vs NEXT -->
        <exclusiveGateway id="exclusiveGateway" name="End or Continue?"/>

        <!-- Sequence: Gateway -> End (if endProcess=true) -->
        <sequenceFlow id="flow_gateway_to_end" sourceRef="exclusiveGateway" targetRef="endEvent">
            <conditionExpression xsi:type="tFormalExpression">
                ${endProcess == true}
            </conditionExpression>
        </sequenceFlow>

        <!-- Sequence: Gateway -> UserTask (loop back, if endProcess=false) -->
        <sequenceFlow id="flow_gateway_to_task" sourceRef="exclusiveGateway" targetRef="userTask">
            <conditionExpression xsi:type="tFormalExpression">
                ${endProcess == false}
            </conditionExpression>
        </sequenceFlow>

        <!-- End Event -->
        <endEvent id="endEvent" name="End"/>

    </process>

</definitions>

