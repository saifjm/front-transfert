# Application
spring.application.name=AVA
server.port=8080

# =============== DEFAULT DATASOURCE (domi) =================
spring.datasource.url=jdbc:oracle:thin:@//37.187.250.163:1521/AVA_POC
# spring.datasource.jdbcUrl=jdbc:oracle:thin:@//37.187.250.163:1521/AVA_POC
spring.datasource.username=ava
spring.datasource.password=ava
spring.datasource.driver-class-name=oracle.jdbc.OracleDriver
spring.datasource.type=com.zaxxer.hikari.HikariDataSource
spring.datasource.hikari.pool-name=Hikari
spring.datasource.hikari.auto-commit=false
spring.jpa.properties.hibernate.jdbc.time_zone=UTC
spring.jackson.time-zone=UTC
# Let Hibernate detect the dialect automatically
# spring.jpa.database-platform=org.hibernate.dialect.Oracle12cDialect

# =============== JPA / Hibernate =================
# Use 'update' during development to auto-update schema
spring.jpa.hibernate.ddl-auto=update
# Allow Hibernate to read JDBC metadata (required for 'update')
spring.jpa.properties.hibernate.boot.allow_jdbc_metadata_defaults=false

# Optional SQL logging for debugging
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# Use local transactions (no JTA)
spring.jpa.properties.hibernate.transaction.jta.platform=org.hibernate.engine.transaction.jta.platform.internal.NoJtaPlatform

# Logging DDL pour voir où ça bloque
logging.level.org.hibernate.tool.schema=DEBUG
logging.level.org.hibernate.SQL=DEBUG

# Optimisations pour éviter le blocage lors de l'update
spring.datasource.hikari.connection-timeout=60000
spring.datasource.hikari.validation-timeout=5000

# =============== HIBERNATE ENVERS (Audit) =================
spring.jpa.properties.org.hibernate.envers.audit_table_suffix=_AUD
spring.jpa.properties.org.hibernate.envers.revision_field_name=REV
spring.jpa.properties.org.hibernate.envers.revision_type_field_name=REVTYPE
spring.jpa.properties.org.hibernate.envers.store_data_at_delete=true
# Désactiver temporairement l'auto-registration pour éviter le blocage au démarrage
# Réactivez après la première création des tables
spring.jpa.properties.org.hibernate.envers.autoRegisterListeners=false

# =============== API EXTERNE =================
api.externe.base-url=http://localhost:8085

# URL de base de l'API REF (Referentiels - Agences, etc.)
api.ref.base-url=http://localhost:8443

